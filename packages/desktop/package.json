{
  "name": "@fluid/desktop",
  "license": "MIT",
  "productName": "Fluid",
  "version": "0.1.0",
  "description": "The Fluid desktop app: Electron main process, preload and renderer.",
  "main": "./out/main/index.js",
  "author": "Fluid",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux",
    "test:isolation": "node test/isolation/run.mjs",
    "test:updater": "node --test test/updater.test.mjs",
    "test:claude-cli": "node --test test/claude-cli.test.mjs",
    "icons": "electron scripts/theme-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@electric-sql/pglite": "^0.5.8",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fluid/extension-claude-code": "workspace:*",
    "@fluid/extension-html": "workspace:*",
    "@fluid/extension-image": "workspace:*",
    "@fluid/extension-pdf": "workspace:*",
    "@fluid/extension-slack": "workspace:*",
    "@fluid/extension-terminal": "workspace:*",
    "@fluid/extension-video": "workspace:*",
    "@fluid/extension-vscode": "workspace:*",
    "@fluid/sdk": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/tailwind4": "^1.2.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "private": true
}
