{
  "name": "@fluid/extension-terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Terminal tabs: a real shell behind each one, drawn with xterm.js.",
  "exports": {
    ".": "./src/index.ts",
    "./renderer": "./src/renderer/index.ts",
    "./views": "./src/views/index.svelte.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fluid/sdk": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.1",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
